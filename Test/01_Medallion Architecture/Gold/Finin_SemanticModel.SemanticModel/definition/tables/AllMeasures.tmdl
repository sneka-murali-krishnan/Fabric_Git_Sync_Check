	measure RandomColor =
			VAR cR =
			    RANDBETWEEN ( 0, 255 )
			VAR cG =
			    RANDBETWEEN ( 0, 255 )
			VAR cB =
			    RANDBETWEEN ( 0, 255 )
			VAR RedP0 =
			    MOD ( cR, 16 )
			VAR RedP1 =
			    MOD ( INT ( cR / 16 ), 16 )
			VAR GreenP0 =
			    MOD ( cG, 16 )
			VAR GreenP1 =
			    MOD ( INT ( cG / 16 ), 16 )
			VAR BlueP0 =
			    MOD ( cB, 16 )
			VAR BlueP1 =
			    MOD ( INT ( cB / 16 ), 16 )
			VAR hexTable =
			    ADDCOLUMNS (
			        { RedP1, RedP0, GreenP1, GreenP0, BlueP1, BlueP0 },
			        "Hex", SWITCH (
			            [Value],
			            10, "A",
			            11, "B",
			            12, "C",
			            13, "D",
			            14, "E",
			            15, "F",
			            [Value]
			        )
			    )
			RETURN
			    "#" & CONCATENATEX ( hexTable, [Hex], "" )
		lineageTag: 276e76b4-5c4a-4b0c-98ee-298eeb808be3

