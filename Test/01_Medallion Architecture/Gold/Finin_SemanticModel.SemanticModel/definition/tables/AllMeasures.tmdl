	measure '''Total Market Value GOS100''' =
			CALCULATE(
			    SUM(RptPosAnalytics[UnPivotValue]),
			    RptPosAnalytics[Metric] = "HoldingsMarketValue",
			    RptPosAnalytics[PFBMCode] = "GOS100",
			    RptPosAnalytics[EffectiveDt] = MAX(RptPosAnalytics[EffectiveDt])
			)
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 8ac33312-7738-408c-8712-5f27ddc6c867

	measure VarianceTest =
			VAR PrimaryPf__ = VALUES('RptPortfolioBenchmarkVariance'[PFBMCode])
			VAR SecondaryPf__ = VALUES('RptPortfolioBenchmarkVariance'[VariancePFBMCode])
			VAR PFBMType__ = MIN('RptPortfolioBenchmarkVariance'[Type])
			
			VAR PrimaryData__ =
			    CALCULATE(
			        SUMX(
			            'DimAggregationMetric',
			            SWITCH(
			                TRUE(),
			                'DimAggregationMetric'[Formula] = "SUM", SUM('RptPosAnalytics'[UnPivotValue]),
			                'DimAggregationMetric'[Formula] = "AVERAGE", AVERAGE('RptPosAnalytics'[UnPivotValue]),
			                'DimAggregationMetric'[Formula] = "MAX", MAX('RptPosAnalytics'[UnPivotValue]),
			                'DimAggregationMetric'[Formula] = "MIN", MIN('RptPosAnalytics'[UnPivotValue]),
			                0
			            )
			        ),
			        FILTER(RptPosAnalytics, RptPosAnalytics[PFBMCode] IN PrimaryPf__)
			    )
			
			VAR SecondaryData__ =
			    IF(
			        PFBMType__ = "3-Variance",
			        CALCULATE(
			            SUMX(
			                'DimAggregationMetric',
			                SWITCH(
			                    TRUE(),
			                    'DimAggregationMetric'[Formula] = "SUM", SUM('RptPosAnalytics'[UnPivotValue]),
			                    'DimAggregationMetric'[Formula] = "AVERAGE", AVERAGE('RptPosAnalytics'[UnPivotValue]),
			                    'DimAggregationMetric'[Formula] = "MAX", MAX('RptPosAnalytics'[UnPivotValue]),
			                    'DimAggregationMetric'[Formula] = "MIN", MIN('RptPosAnalytics'[UnPivotValue]),
			                    0
			                )
			            ),
			            FILTER(RptPosAnalytics, RptPosAnalytics[PFBMCode] IN SecondaryPf__)
			        ),
			        0
			    )
			
			RETURN
			    IF(
			        NOT ISBLANK(PrimaryData__) && NOT ISBLANK(SecondaryData__),
			        PrimaryData__ - SecondaryData__
			    )
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 084dd190-366e-4499-aec8-93461a304bf9

	measure #AnalyticsTest =
