	measure SumOfHolding = ```
			VAR PrimaryPf__ = VALUES('RptPortfolioBenchmarkVariance'[PFBMCode])  -- Get the unique PFBMCode values
			
			VAR PrimaryData__ = 
			    CALCULATE(
			        SUM(RptPosAnalytics[UnPivotValue]),  -- Find the minimum value of UnPivotValue
			        RptPosAnalytics[Metric] = "HoldingsMarketValue",  -- Filter by Metric = "ESG"
			        RptPosAnalytics[PFBMCode] IN PrimaryPf__,  -- Filter by PFBMCode in the set of PrimaryPf__
			        FORMAT(RptPosAnalytics[FormatedEffectiveDt], "DD-MM-YYYY") = FORMAT((MIN(DimDate[Date]) - 1), "DD-MM-YYYY")  -- Apply the same date filter
			    )
			
			RETURN PrimaryData__  -- Return the calculated minimum value
			```
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
