	measure #Analytics =
			VAR date__ = FORMAT(MIN(DimDate[Date]), "YYYY-MM-DD")
			RETURN
			    CALCULATE(
			        [Variance],
			        FILTER(
			            RptPosAnalytics,
			            FORMAT(RptPosAnalytics[FormatedEffectiveDt], "YYYY-MM-DD") = date__
			        )
			    )
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: eca87919-28a3-4d12-b316-1dea7b2e583b

	measure Variance = ```
			var PrimaryPf__ = VALUES('RptPortfolioBenchmarkVariance'[PFBMCode])
			var SecondaryPf__ = VALUES('RptPortfolioBenchmarkVariance'[VariancePFBMCode])
			var PFBMType__ = MIN('RptPortfolioBenchmarkVariance'[Type])
			
			var PrimaryData__ = CALCULATE(SUMX (
			'DimAggregationMetric' ,
			 IF ('DimAggregationMetric'[Formula] = "SUM", SUM('RptPosAnalytics'[UnPivotValue]),
			     IF( 'DimAggregationMetric'[Formula] = "AVERAGE" , AVERAGE('RptPosAnalytics'[UnPivotValue]), 
			     IF( 'DimAggregationMetric'[Formula] = "MAX" , MAX('RptPosAnalytics'[UnPivotValue]), 
			     IF( 'DimAggregationMetric'[Formula] = "MIN" , MIN('RptPosAnalytics'[UnPivotValue])) ) ) 
			
			))
			,FILTER(RptPosAnalytics,RptPosAnalytics[PFBMCode] IN PrimaryPf__)
			)
			
			var SecondaryData__ = 
			IF (PFBMType__ = "3-Variance", 
			CALCULATE(SUMX (
			'DimAggregationMetric' ,
			 IF ('DimAggregationMetric'[Formula] = "SUM", SUM('RptPosAnalytics'[UnPivotValue]),
			     IF( 'DimAggregationMetric'[Formula] = "AVERAGE" , AVERAGE('RptPosAnalytics'[UnPivotValue]), 
			     IF( 'DimAggregationMetric'[Formula] = "MAX" , MAX('RptPosAnalytics'[UnPivotValue]), 
			     IF( 'DimAggregationMetric'[Formula] = "MIN" , MIN('RptPosAnalytics'[UnPivotValue])) ) )
			
			))
			,FILTER(RptPosAnalytics,RptPosAnalytics[PFBMCode] in SecondaryPf__)
			)
			,0
			)
			
			RETURN  IF (
			        NOT ISBLANK ( PrimaryData__ ) && NOT ISBLANK ( SecondaryData__ ),
			        PrimaryData__ - SecondaryData__ 
			    )
			```
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 38ba98a6-7867-49c5-aa80-ac2ba9a9683a

