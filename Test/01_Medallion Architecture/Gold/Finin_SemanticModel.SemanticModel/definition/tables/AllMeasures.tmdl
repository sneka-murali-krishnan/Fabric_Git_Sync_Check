	measure CombinedMeasure = ```
			VAR date__ = FORMAT(MIN(DimDate[Date]), "YYYY-MM-DD")
			VAR PrimaryPf__ = VALUES('RptPortfolioBenchmarkVariance'[PFBMCode])
			VAR SecondaryPf__ = VALUES('RptPortfolioBenchmarkVariance'[VariancePFBMCode])
			VAR PFBMType__ = MIN('RptPortfolioBenchmarkVariance'[Type])
			
			VAR PrimaryData__ = 
			    CALCULATE(
			        SUMX(
			            'DimAggregationMetric',
			            SWITCH(
			                'DimAggregationMetric'[Formula],
			                "SUM", SUM('RptPosAnalytics'[UnPivotValue]),
			                "AVERAGE", AVERAGE('RptPosAnalytics'[UnPivotValue]),
			                "MAX", MAX('RptPosAnalytics'[UnPivotValue]),
			                "MIN", MIN('RptPosAnalytics'[UnPivotValue])
			            )
			        ),
			        FILTER(RptPosAnalytics, RptPosAnalytics[PFBMCode] IN PrimaryPf__)
			    )
			
			VAR SecondaryData__ = 
			    IF(
			        PFBMType__ = "3-Variance",
			        CALCULATE(
			            SUMX(
			                'DimAggregationMetric',
			                SWITCH(
			                    'DimAggregationMetric'[Formula],
			                    "SUM", SUM('RptPosAnalytics'[UnPivotValue]),
			                    "AVERAGE", AVERAGE('RptPosAnalytics'[UnPivotValue]),
			                    "MAX", MAX('RptPosAnalytics'[UnPivotValue]),
			                    "MIN", MIN('RptPosAnalytics'[UnPivotValue])
			                )
			            ),
			            FILTER(RptPosAnalytics, RptPosAnalytics[PFBMCode] IN SecondaryPf__)
			        ),
			        0
			    )
			
			RETURN 
			    CALCULATE(
			        PrimaryData__,
			        FILTER(
			            RptPosAnalytics,
			            FORMAT(RptPosAnalytics[EffectiveDt], "YYYY-MM-DD") = date__
			        )
			    )
			```
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 1737e4eb-d93c-4efc-8eaf-d3cf51070fec

	measure #AnalyticsFormatted =
