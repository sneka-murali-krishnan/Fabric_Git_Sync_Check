	measure SelectedPeriodToDate =
			VAR SelectedPeriod = SELECTEDVALUE(RptPeriodToDate[ShortName])
			VAR StartDate = MIN(DimDate[Date])
			VAR EndDate = MAX(DimDate[Date])
			
			RETURN
			    SWITCH(
			        SelectedPeriod,
			        "YTD", IF(MAX(DimDate[Date]) >= DATE(YEAR(TODAY()), 1, 1) && MAX(DimDate[Date]) <= TODAY(), 1, 0),
			        "QTD", IF(MAX(DimDate[Date]) >= STARTOFQUARTER(TODAY()) && MAX(DimDate[Date]) <= TODAY(), 1, 0),
			        "MTD", IF(MAX(DimDate[Date]) >= STARTOFMONTH(TODAY()) && MAX(DimDate[Date]) <= TODAY(), 1, 0),
			        "Custom", IF(MAX(DimDate[Date]) >= StartDate && MAX(DimDate[Date]) <= EndDate, 1, 0),
			        1
			    )
		lineageTag: d2a6c12f-1cef-456c-896b-625641b09950

	measure NetAssetValue =
			VAR LastBusinessDay =
			    MAXX(
			        FILTER(
			            DimDate,
			            DimDate[Date] =
			                MAXX(
			                    FILTER(
			                        DimDate,
			                        DimDate[Date] <= ENDOFMONTH(DimDate[Date]) &&
			                        WEEKDAY(DimDate[Date], 2) <= 5
			                    ),
			                    DimDate[Date]
			                )
			        ),
			        DimDate[Date]
			    )
			RETURN
			CALCULATE(
			    SUMX(FactTransact, FactTransact[PriceLocal] * FactTransact[Quantity]),
			    DimDate[Date] = LastBusinessDay
			)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: abfef0a5-c20a-4531-bb30-cde77b2090f8

