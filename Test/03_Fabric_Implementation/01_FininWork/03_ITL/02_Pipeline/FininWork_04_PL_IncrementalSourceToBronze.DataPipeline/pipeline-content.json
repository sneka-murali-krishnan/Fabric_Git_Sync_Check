              "value": "@concat('\nSELECT\n    Id,\n    SourceSchemaName,\n    SourceTableName,\n    BronzeSchemaName,\n    BronzeTableName,\n    SilverSchemaName,\n    SilverTableName,\n    LoadType,\n    PrimaryKey,\n    IsFullLoad,\n    IncLoadType,\n    SourceDeleteQuery,\n    CreatedWaterMarkField,\n    CreatedWaterMarkValue,\n    UpdatedWaterMarkField,\n    UpdatedWaterMarkValue,\n    IsActive,\n    IsSourceDelete,\n    CASE\n        WHEN IsFullLoad = 1 THEN\n            SourceQuery\n        WHEN IncLoadType = 2 THEN\n            REPLACE(SourceQuery + '' WHERE CAST('' + CreatedWaterMarkField + '' AS DATE) > CAST('''''' + CONVERT(VARCHAR(19), COALESCE(CreatedWaterMarkValue, ''1900-01-01''), 120) + '''''' AS DATE)'', CHAR(13), '''')\n        WHEN IncLoadType = 3 THEN\n            REPLACE(SourceQuery + '' WHERE CAST('' + UpdatedWaterMarkField + '' AS DATE) > CAST('''''' + CONVERT(VARCHAR(19), COALESCE(UpdatedWaterMarkValue, ''1900-01-01''), 120) + '''''' AS DATE)'', CHAR(13), '''')\n        WHEN IncLoadType = 4 THEN\n            REPLACE(SourceQuery + '' WHERE (CAST('' + CreatedWaterMarkField + '' AS DATE) > CAST('''''' + CONVERT(VARCHAR(19), COALESCE(CreatedWaterMarkValue, ''1900-01-01''), 120) + '''''' AS DATE)) OR (CAST('' + UpdatedWaterMarkField + '' AS DATE) > CAST('''''' + CONVERT(VARCHAR(19), COALESCE(UpdatedWaterMarkValue, ''1900-01-01''), 120) + '''''' AS DATE))'', CHAR(13), '''')\n        ELSE\n            SourceQuery\n    END AS SourceQuery\nFROM [WH_MetaData].[Config_', pipeline().parameters.SchemaName, '].[IncrementalConfigETL]\nWHERE IsActive = 1\nORDER BY Id\n')",
              "type": "Expression"
            },
            "partitionOption": "None",
            "queryTimeout": "02:00:00"
